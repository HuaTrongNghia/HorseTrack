@baseUrl = http://localhost:8080
@token = dán_chuỗi_token_vào_đây
@refreshToken = dán_refresh_token_vào_đây

###############################################################################
# 1. AUTHENTICATION & TÀI KHOẢN (JWT, ĐĂNG NHẬP, ĐĂNG KÝ, REFRESH, LOGOUT)
###############################################################################

### 1.1 Đăng nhập Club Manager lấy Token
# @name loginManager
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "manager_admin",
  "password": "Password123!"
}

### 1.2 Đăng nhập Huấn luyện viên (Head Trainer)
# @name loginTrainer
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "trainer_hung",
  "password": "Password123!"
}

### 1.3 Đăng nhập Nhân viên chăm sóc (Groom)
# @name loginGroom
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "groom_nam",
  "password": "Password123!"
}

### 1.4 Đăng nhập Bác sĩ thú y (Veterinarian)
# @name loginVet
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "vet_duc",
  "password": "Password123!"
}

### 1.5 Đăng nhập Thủ kho (Warehouse Manager)
# @name loginWarehouse
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "warehouse_admin",
  "password": "Password123!"
}

### 1.6 Đăng nhập Chủ ngựa (Horse Owner)
# @name loginOwner
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "chu_ngua_lanhoang",
  "password": "Password123!"
}

### 1.5 Đăng ký Chủ ngựa mới
POST {{baseUrl}}/api/v1/auth/register-owner
Content-Type: application/json

{
  "username": "owner_test01",
  "password": "Password123!",
  "fullName": "Nguyễn Văn Chủ Ngựa",
  "email": "owner01@test.com",
  "phone": "0912345678",
  "taxCode": "0312456789",
  "billingAddress": "123 Đường Lê Lợi, Quận 1, TP.HCM"
}

### 1.6 Club Manager tạo tài khoản nhân viên (Groom / Trainer / Veterinarian)
POST {{baseUrl}}/api/v1/auth/staff/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "groom_02",
  "password": "Password123!",
  "fullName": "Lê Văn Chăm Sóc",
  "email": "groom02@horsetrack.com",
  "phone": "0987654321",
  "roleName": "Groom",
  "licenseNumber": "",
  "specialization": "Vệ sinh chuồng trại"
}

### 1.7 Làm mới Access Token bằng Refresh Token (Mỗi token dùng 1 lần)
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 1.10 Đăng xuất (Thu hồi refresh token & đưa access token vào blacklist)
POST {{baseUrl}}/api/v1/auth/logout
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "refreshToken": "{{refreshToken}}"
}

### 1.11 Quên mật khẩu: Yêu cầu gửi mã OTP về email (Hiệu lực 5 phút)
POST {{baseUrl}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "groom01@horsetrack.com"
}

### 1.12 Quên mật khẩu: Đặt lại mật khẩu mới bằng OTP
POST {{baseUrl}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "email": "groom01@horsetrack.com",
  "otp": "123456",
  "newPassword": "NewPassword123!",
  "confirmNewPassword": "NewPassword123!"
}

### 1.13 Xem thông tin tài khoản cá nhân đang đăng nhập
GET {{baseUrl}}/api/v1/account/my-profile
Authorization: Bearer {{token}}

### 1.14 Đổi mật khẩu Bước 1: Yêu cầu gửi OTP về email tài khoản đang đăng nhập
POST {{baseUrl}}/api/v1/account/change-password/otp
Authorization: Bearer {{token}}

### 1.15 Đổi mật khẩu Bước 2: Xác nhận đổi mật khẩu với OTP
PUT {{baseUrl}}/api/v1/account/change-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "oldPassword": "Password123!",
  "newPassword": "NewPassword123!",
  "confirmNewPassword": "NewPassword123!",
  "otp": "123456"
}


###############################################################################
# 2. QUẢN LÝ NGƯỜI DÙNG, PHÂN CÔNG & NHẬT KÝ HỆ THỐNG (CLUB MANAGER)
###############################################################################

### 2.1 Xem danh sách người dùng (Phân trang & Tìm kiếm & Lọc Role/Status)
GET {{baseUrl}}/api/v1/users?page=0&size=20&search=&role=Groom&status=ACTIVE
Authorization: Bearer {{token}}

### 2.2 Xem danh sách toàn bộ người dùng phẳng (để nạp nhanh vào Dropdown)
GET {{baseUrl}}/api/v1/users/all
Authorization: Bearer {{token}}

### 2.3 Xem chi tiết 1 người dùng theo ID
GET {{baseUrl}}/api/v1/users/2
Authorization: Bearer {{token}}

### 2.4 Khóa hoặc Mở khóa tài khoản người dùng
PUT {{baseUrl}}/api/v1/users/2/status?status=LOCKED
Authorization: Bearer {{token}}

### 2.5 Phân công khu vực chuồng (Groom Zone) cho nhân viên Groom
PUT {{baseUrl}}/api/v1/users/3/groom-zone
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "zone": "Khu A"
}

### 2.6 Xem nhật ký hệ thống (Audit Trail)
GET {{baseUrl}}/api/v1/audit-logs?page=0&size=20
Authorization: Bearer {{token}}


###############################################################################
# 3. QUẢN LÝ HỒ SƠ NGỰA (HORSES)
###############################################################################

### 3.1 Chủ ngựa / Quản lý đăng ký ngựa mới vào CLB
POST {{baseUrl}}/api/v1/horses/register
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseName": "Thần Mã Siêu Tốc",
  "dateOfBirth": "2022-04-15",
  "gender": "STALLION",
  "breed": "Thoroughbred",
  "color": "Hạt dẻ (Chestnut)",
  "microchipNumber": "985141001234567",
  "ownerId": 5,
  "stallId": 1
}

### 3.2 Lấy danh sách tất cả ngựa (Phân trang & lọc trạng thái)
GET {{baseUrl}}/api/v1/horses?page=0&size=10
Authorization: Bearer {{token}}

### 3.3 Xem chi tiết hồ sơ 1 con ngựa
GET {{baseUrl}}/api/v1/horses/1
Authorization: Bearer {{token}}

### 3.4 Chủ ngựa xem danh sách ngựa thuộc sở hữu của mình
GET {{baseUrl}}/api/v1/horses/my-horses/5
Authorization: Bearer {{token}}

### 3.5 Huấn luyện viên lấy danh sách ngựa đủ điều kiện tập luyện
GET {{baseUrl}}/api/v1/horses/available-for-training
Authorization: Bearer {{token}}

### 3.6 Club Manager phê duyệt hồ sơ đăng ký ngựa
PUT {{baseUrl}}/api/v1/horses/1/approve
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isApproved": true,
  "rejectionReason": ""
}

### 3.7 Cập nhật thông tin ngựa
PUT {{baseUrl}}/api/v1/horses/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseName": "Thần Mã Chiến Binh",
  "color": "Hắc mã (Black)",
  "stallId": 2
}


###############################################################################
# 4. SƠ ĐỒ CHUỒNG TRẠI (STALL MAP)
###############################################################################

### 4.1 Xem sơ đồ vị trí chuồng trại (Stall Map & trạng thái từng ô)
GET {{baseUrl}}/api/v1/stalls/map
Authorization: Bearer {{token}}

### 4.2 Cập nhật đơn giá thuê chuồng mỗi ngày (Daily Rate)
PUT {{baseUrl}}/api/v1/billing/stalls/1/daily-rate?dailyRate=180000
Authorization: Bearer {{token}}


###############################################################################
# 5. KHẨU PHẦN ĂN & DINH DƯỠNG (NUTRITION PLANS & DIET CHANGES)
###############################################################################

### 5.1 Lấy danh mục thức ăn & chất bổ sung trong kho để lên thực đơn
GET {{baseUrl}}/api/v1/nutrition-plans/feed-items
Authorization: Bearer {{token}}

### 5.2 Khởi tạo thực đơn dinh dưỡng mới cho ngựa (Trainer / Vet)
POST {{baseUrl}}/api/v1/nutrition-plans
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseId": 1,
  "targetDailyCalories": 35000,
  "specialNotes": "Bổ sung điện giải sau tập nặng",
  "details": [
    {
      "mealType": "MORNING",
      "itemId": 1,
      "portionSize": 2.5,
      "feedingInstructions": "Ngâm mềm 10 phút trước khi cho ăn"
    },
    {
      "mealType": "NOON",
      "itemId": 2,
      "portionSize": 1.5,
      "feedingInstructions": "Trộn đều cùng cỏ khô"
    },
    {
      "mealType": "EVENING",
      "itemId": 1,
      "portionSize": 3.0,
      "feedingInstructions": "Cho ăn trước 18h"
    }
  ]
}

### 5.3 Xem danh sách thực đơn dinh dưỡng
GET {{baseUrl}}/api/v1/nutrition-plans?horseId=1
Authorization: Bearer {{token}}

### 5.4 Lấy khẩu phần ăn hôm nay của ngựa theo bữa (MORNING, NOON, EVENING)
GET {{baseUrl}}/api/v1/nutrition-plans/today?horseId=1&mealType=MORNING
Authorization: Bearer {{token}}

### 5.5 Kích hoạt thực đơn dinh dưỡng
PUT {{baseUrl}}/api/v1/nutrition-plans/1/activate
Authorization: Bearer {{token}}

### 5.6 Vô hiệu hóa thực đơn dinh dưỡng
PUT {{baseUrl}}/api/v1/nutrition-plans/1/deactivate
Authorization: Bearer {{token}}

### 5.7 Groom hoặc Trainer gửi đề xuất thay đổi thức ăn đặc biệt
POST {{baseUrl}}/api/v1/diet-requests
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseId": 1,
  "requestType": "SPECIAL_DIET",
  "reason": "Ngựa có dấu hiệu đầy hơi, đề xuất giảm 50% cám tinh và tăng cỏ Alfalfa",
  "proposedDetails": "Cỏ Alfalfa 4kg/ngày, men tiêu hóa 1 gói/bữa"
}

### 5.8 Xem danh sách các đề xuất đổi khẩu phần ăn
GET {{baseUrl}}/api/v1/diet-requests?status=PENDING
Authorization: Bearer {{token}}

### 5.9 Bác sĩ thú y xét duyệt đề xuất thay đổi thức ăn (APPROVED / REJECTED)
PUT {{baseUrl}}/api/v1/diet-requests/1/decide
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "decision": "APPROVED",
  "vetNotes": "Đồng ý chuyển sang cỏ Alfalfa và men tiêu hóa trong 5 ngày tới"
}


###############################################################################
# 6. GIÁO ÁN HUẤN LUYỆN & LẬP LỊCH TẬP (TRAINING PLANS & SESSIONS)
###############################################################################

### 6.1 Thống kê tổng quan màn hình Huấn luyện (Dashboard Stats)
GET {{baseUrl}}/api/v1/training-plans/dashboard-stats
Authorization: Bearer {{token}}

### 6.2 Lấy danh sách giáo án huấn luyện (Có phân trang & lọc status)
GET {{baseUrl}}/api/v1/training-plans?status=ACTIVE&page=0&size=10
Authorization: Bearer {{token}}

### 6.3 Tạo mới giáo án huấn luyện (Head Trainer)
POST {{baseUrl}}/api/v1/training-plans
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseId": 1,
  "planName": "Giáo án rèn luyện tốc độ mùa thu 2026",
  "startDate": "2026-11-01",
  "endDate": "2026-12-01",
  "targetGoal": "Đạt vận tốc nước kiệu 45km/h và bứt tốc 60km/h",
  "assignedTrainerId": 2
}

### 6.4 Xem chi tiết Giáo án & các buổi tập theo ID
GET {{baseUrl}}/api/v1/training-plans/1
Authorization: Bearer {{token}}

### 6.5 Lấy danh sách nhân viên có thể phân công buổi tập (Groom & Trainer)
GET {{baseUrl}}/api/v1/training-plans/assignable-staff
Authorization: Bearer {{token}}

### 6.6 Head Trainer tạo buổi tập mới vào giáo án
POST {{baseUrl}}/api/v1/training-plans/1/sessions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "sessionDate": "2026-11-05T08:00:00",
  "activityType": "Chạy bứt tốc cự ly 1000m",
  "notes": "Quan sát độ co giãn cơ bắp sau khi về đích",
  "assignedToId": 3
}


###############################################################################
# 7. THỰC THI BUỔI TẬP, ĐÁNH GIÁ & XỬ LÝ SỰ CỐ KHẨN CẤP
###############################################################################

### 7.1 Huấn luyện viên / Groom xem lịch tập cá nhân của mình
GET {{baseUrl}}/api/v1/training-sessions/my-schedule?startDate=2026-10-20&endDate=2026-11-30
Authorization: Bearer {{token}}

### 7.2 Groom xác nhận nhận buổi tập (CONFIRMED)
PUT {{baseUrl}}/api/v1/training-sessions/1/confirm
Authorization: Bearer {{token}}

### 7.3 Hoàn thành buổi tập và ghi lại thông số (Nhịp tim, Tốc độ, Quãng đường)
PUT {{baseUrl}}/api/v1/training-sessions/1/execute
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "durationMinutes": 45,
  "distanceMeters": 3500.0,
  "avgSpeedKmh": 42.5,
  "maxHeartRateBpm": 165,
  "recoveryHeartRateBpm": 78,
  "performanceNotes": "Ngựa đạt phong độ rất tốt, hồi phục tim sau 10 phút."
}

### 7.4 DỪNG BUỔI TẬP KHẨN CẤP do chỉ số vượt ngưỡng -> Tự động tạo ca VetCase gửi Bác sĩ
PUT {{baseUrl}}/api/v1/training-sessions/1/stop
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reason": "Nhịp tim vọt lên 210 bpm, ngựa thở dốc bất thường",
  "heartRate": 210,
  "speedKmh": 55.0,
  "severity": "HIGH",
  "requestVet": true
}

### 7.5 Huấn luyện viên chấm điểm và đánh giá buổi tập đã hoàn thành
POST {{baseUrl}}/api/v1/training-sessions/1/evaluate
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "score": 9,
  "comment": "Rất hài lòng với sức bền hôm nay, chú ý bước chân trái."
}


###############################################################################
# 8. THEO DÕI HUẤN LUYỆN DÀNH CHO CHỦ NGỰA (OWNER TRAINING)
###############################################################################

### 8.1 Chủ ngựa xem danh sách ngựa của mình kèm thông tin giáo án đang chạy
GET {{baseUrl}}/api/v1/owner/training/my-horses
Authorization: Bearer {{token}}

### 8.2 Chủ ngựa xem tiến độ chi tiết, biểu đồ buổi tập của ngựa
GET {{baseUrl}}/api/v1/owner/training/horses/1/progress
Authorization: Bearer {{token}}


###############################################################################
# 9. CÔNG VIỆC CHĂM SÓC HÀNG NGÀY & CHO ĂN (CARE TASKS)
###############################################################################

### 9.1 Groom xem danh sách công việc cần làm hôm nay của mình
GET {{baseUrl}}/api/v1/care-tasks/my-tasks
Authorization: Bearer {{token}}

### 9.2 Groom hoàn thành công việc (Tự động trừ tồn kho nếu là FEEDING)
PUT {{baseUrl}}/api/v1/care-tasks/1/complete
Authorization: Bearer {{token}}


###############################################################################
# 10. KHÓA Y TẾ KHẨN CẤP (VETLOCK)
###############################################################################

### 10.1 Kích hoạt Khóa y tế khẩn cấp (VetLock) tạm dừng mọi hoạt động của ngựa
POST {{baseUrl}}/api/v1/medical/vet-lock
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseId": 1,
  "reason": "Phát hiện sưng phù gân chân trước bên phải sau buổi tập"
}

### 10.2 Mở khóa VetLock khi ngựa đã hồi phục hoàn toàn
POST {{baseUrl}}/api/v1/medical/release-lock/1
Authorization: Bearer {{token}}


###############################################################################
# 11. BỆNH ÁN & DUYỆT PHÁC ĐỒ ĐIỀU TRỊ (MEDICAL RECORDS)
###############################################################################

### 11.1 Bác sĩ tạo hồ sơ bệnh án mới (kê đơn & đánh dấu chấn thương trên sơ đồ)
POST {{baseUrl}}/api/v1/veterinary/medical-records
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseId": 1,
  "visitDate": "2026-10-25",
  "symptoms": "Đi khập khiễng nhẹ chân trước bên phải",
  "diagnosis": "Viêm màng bao gân nhẹ do tập quá tải",
  "isLockoutOrdered": true,
  "injuryMarks": [
    {
      "bodyPartCode": "FRONT_RIGHT_LEG",
      "coordX": 150.5,
      "coordY": 320.0,
      "severityLevel": "MODERATE"
    }
  ],
  "prescriptionItems": [
    {
      "itemId": 3,
      "quantityPrescribed": 2,
      "dosage": "Uống 1 liều/ngày sau bữa ăn sáng"
    }
  ]
}

### 11.2 Club Manager phê duyệt hồ sơ bệnh án
PUT {{baseUrl}}/api/v1/manager/medical-records/1/approve
Authorization: Bearer {{token}}

### 11.3 Chủ ngựa thanh toán viện phí y tế
POST {{baseUrl}}/api/v1/owner/payments/medical-records/1/vnpay
Authorization: Bearer {{token}}


###############################################################################
# 12. PHÁC ĐỒ ĐIỀU TRỊ & CA BỆNH CỦA BÁC SĨ (MEDICAL MANAGEMENT)
###############################################################################

### 12.1 Lấy danh mục thuốc trong kho y tế
GET {{baseUrl}}/api/v1/medical-management/medications
Authorization: Bearer {{token}}

### 12.2 Khởi tạo phác đồ điều trị nhiều giai đoạn & trừ tồn kho thuốc
POST {{baseUrl}}/api/v1/medical-management/protocols
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "horseId": 1,
  "caseId": "C-0015",
  "diagnosis": "Viêm bao gân cấp tính",
  "targetDate": "2026-11-15",
  "stages": [
    {
      "stageName": "Giai đoạn 1: Giảm đau & kháng viêm",
      "startDate": "2026-10-25",
      "durationDays": 5,
      "goal": "Hạ sưng và giảm đau tại khớp",
      "items": [
        {
          "medicationId": 3,
          "quantity": 2
        }
      ]
    }
  ]
}

### 12.3 Hộp thư ca bệnh cần xử lý của Bác sĩ thú y
GET {{baseUrl}}/api/v1/medical/cases?status=ALL
Authorization: Bearer {{token}}

### 12.4 Bác sĩ ghi nhận hướng xử lý ca bệnh
POST {{baseUrl}}/api/v1/medical/cases/action?vetId=4
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "caseId": "C-0015",
  "vetNotes": "Khớp chân trước sưng nhẹ, đề xuất nghỉ tập 7 ngày và dùng kháng viêm",
  "treatmentDirection": "Khóa huấn luyện, theo dõi chỉ số tim mạch hằng ngày"
}


###############################################################################
# 13. QUẢN LÝ KHO & VẬT TƯ (INVENTORY & SUPPLIES)
###############################################################################

### 13.1 Xem danh mục vật tư tồn kho (Phân trang, tìm kiếm & lọc category)
GET {{baseUrl}}/api/v1/inventory/items?page=0&size=20&search=&category=FEED
Authorization: Bearer {{token}}

### 13.2 Xem chi tiết 1 mặt hàng tồn kho
GET {{baseUrl}}/api/v1/inventory/items/1
Authorization: Bearer {{token}}

### 13.3 Thêm mặt hàng mới vào danh mục kho
POST {{baseUrl}}/api/v1/inventory/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemCode": "FEED-ALFALFA-01",
  "itemName": "Cỏ Alfalfa Nhập Khẩu Mỹ",
  "category": "FEED",
  "unit": "kg",
  "minStockLevel": 50,
  "unitPrice": 45000
}

### 13.4 Lấy danh sách các nhóm hàng (FEED, MEDICINE, SUPPLEMENT, EQUIPMENT...)
GET {{baseUrl}}/api/v1/inventory/categories
Authorization: Bearer {{token}}

### 13.5 Cảnh báo các mặt hàng sắp hết (dưới ngưỡng an toàn minStockLevel)
GET {{baseUrl}}/api/v1/inventory/low-stock
Authorization: Bearer {{token}}

### 13.6 Xem danh sách các lô hàng của 1 mặt hàng (Lot number & Hạn sử dụng)
GET {{baseUrl}}/api/v1/inventory/lots?itemId=1
Authorization: Bearer {{token}}


###############################################################################
# 14. NHÀ CUNG CẤP & ĐƠN MUA HÀNG (SUPPLIERS & PURCHASE ORDERS)
###############################################################################

### 14.1 Xem danh sách nhà cung cấp
GET {{baseUrl}}/api/v1/inventory/suppliers
Authorization: Bearer {{token}}

### 14.2 Thêm nhà cung cấp mới
POST {{baseUrl}}/api/v1/inventory/suppliers
Content-Type: application/json
Authorization: Bearer {{token}}

{
