    }
  ]
}


###############################################################################
# 15. YÊU CẦU CẤP VẬT TƯ CỦA GROOM (SUPPLY REQUESTS)
###############################################################################

### 15.1 Groom tạo yêu cầu xin cấp vật tư / thức ăn / thuốc
POST {{baseUrl}}/api/v1/supply-requests
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemId": 1,
  "quantity": 10,
  "reason": "Bổ sung cỏ khô cho chuồng khu A đợt cuối tuần"
}

### 15.2 Groom xem lịch sử các yêu cầu cấp vật tư của mình
GET {{baseUrl}}/api/v1/supply-requests/my-requests
Authorization: Bearer {{token}}

### 15.3 Thủ kho xem toàn bộ danh sách yêu cầu cấp vật tư từ các Groom
GET {{baseUrl}}/api/v1/inventory/supply-requests?status=PENDING
Authorization: Bearer {{token}}

### 15.4 Thủ kho phê duyệt xuất kho cho yêu cầu vật tư
PUT {{baseUrl}}/api/v1/inventory/supply-requests/1/approve
Authorization: Bearer {{token}}

### 15.5 Thủ kho từ chối yêu cầu cấp vật tư
PUT {{baseUrl}}/api/v1/inventory/supply-requests/1/reject
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reason": "Mặt hàng này hiện đang ưu tiên cho khu vực cách ly"
}


###############################################################################
# 16. KIỂM KÊ KHO ĐỊNH KỲ (STOCK COUNTS)
###############################################################################

### 16.1 Thủ kho khởi tạo đợt kiểm kê mới
POST {{baseUrl}}/api/v1/inventory/stock-counts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "notes": "Kiểm kê định kỳ kho thức ăn cuối tháng 10/2026",
  "category": "FEED"
}

### 16.2 Xem danh sách các đợt kiểm kê
GET {{baseUrl}}/api/v1/inventory/stock-counts
Authorization: Bearer {{token}}

### 16.3 Xem chi tiết phiếu kiểm kê & các dòng mặt hàng cần đếm
GET {{baseUrl}}/api/v1/inventory/stock-counts/1
Authorization: Bearer {{token}}

### 16.4 Nhập số lượng thực tế đếm được cho 1 dòng kiểm kê
PUT {{baseUrl}}/api/v1/inventory/stock-counts/1/lines/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "countedQuantity": 98,
  "reason": "Hao hụt 2kg do bao rách nhẹ khi vận chuyển"
}

### 16.5 Hoàn thành và chốt đợt kiểm kê (Tự động cân đối tồn kho theo thực tế)
PUT {{baseUrl}}/api/v1/inventory/stock-counts/1/complete
Authorization: Bearer {{token}}


###############################################################################
# 17. KIỂM KHO & CẤP PHÁT THUỐC CHO PHÁC ĐỒ (PROTOCOL STOCK)
###############################################################################

### 17.1 Xem danh sách phác đồ đang chờ cấp phát thuốc
GET {{baseUrl}}/api/v1/inventory/protocols/pending
Authorization: Bearer {{token}}

### 17.2 Kiểm tra tồn kho các loại thuốc trong phác đồ có đủ để cấp hay không
GET {{baseUrl}}/api/v1/inventory/protocols/1/check
Authorization: Bearer {{token}}

### 17.3 Thủ kho xuất cấp thuốc cho phác đồ (Tự động trừ kho)
POST {{baseUrl}}/api/v1/inventory/protocols/1/dispense
Authorization: Bearer {{token}}


###############################################################################
# 18. HÓA ĐƠN & THANH TOÁN VNPAY SANDBOX (BILLING & PAYMENTS)
###############################################################################

### 18.1 Club Manager phát hành hóa đơn tháng hàng loạt cho tất cả chủ ngựa
POST {{baseUrl}}/api/v1/billing/invoices/generate?billingMonth=2026-10
Authorization: Bearer {{token}}

### 18.2 Club Manager xem toàn bộ hóa đơn (Lọc status: UNPAID, OVERDUE, PAID)
GET {{baseUrl}}/api/v1/billing/invoices?status=UNPAID&billingMonth=2026-10&page=0&size=20
Authorization: Bearer {{token}}

### 18.3 Xem chi tiết 1 hóa đơn
GET {{baseUrl}}/api/v1/billing/invoices/1
Authorization: Bearer {{token}}

### 18.4 Hủy hóa đơn sai lệch
PUT {{baseUrl}}/api/v1/billing/invoices/1/cancel
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reason": "Điều chỉnh nhầm phí lưu chuồng kỳ trước"
}

### 18.5 Đình chỉ dịch vụ ngựa do quá hạn thanh toán
PUT {{baseUrl}}/api/v1/billing/invoices/1/suspend
Authorization: Bearer {{token}}

### 18.6 Kích hoạt lại dịch vụ khi chủ ngựa đã nộp tiền
PUT {{baseUrl}}/api/v1/billing/invoices/1/reactivate
Authorization: Bearer {{token}}

### 18.7 Chủ ngựa xem danh sách hóa đơn cần thanh toán của mình
GET {{baseUrl}}/api/v1/owner/invoices/my-invoices?status=UNPAID&page=0&size=20
Authorization: Bearer {{token}}

### 18.8 Chủ ngựa xem chi tiết hóa đơn của mình
GET {{baseUrl}}/api/v1/owner/invoices/1
Authorization: Bearer {{token}}

### 18.9 Tạo URL thanh toán VNPay Sandbox cho hóa đơn
POST {{baseUrl}}/api/v1/payments/vnpay/create-payment?invoiceId=1&bankCode=NCB
Authorization: Bearer {{token}}

### 18.10 VNPay Callback (Return URL sau khi người dùng hoàn tất thanh toán)
GET {{baseUrl}}/api/v1/payments/vnpay/vnpay-return?vnp_Amount=150000000&vnp_BankCode=NCB&vnp_ResponseCode=00&vnp_TxnRef=HT123456
Authorization: Bearer {{token}}

### 18.11 Chủ ngựa tự kiểm tra lại các giao dịch VNPay đang chờ xác minh
POST {{baseUrl}}/api/v1/payments/vnpay/recheck-my-pending
Authorization: Bearer {{token}}


